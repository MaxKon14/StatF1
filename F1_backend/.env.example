# Шаблон окружения. Скопировать и заполнить пустые значения:
#     cp .env.example .env
#
# Сам .env в git не попадает. Пустые значения — секреты, их нужно задать.
# Заполненные — рабочие умолчания для локального запуска, менять не обязательно.

# --- Django ---------------------------------------------------------------
# Ключ для подписи сессий, кук и токенов сброса пароля. Обязателен, умолчания нет.
# Сгенерировать:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Отладочный режим. В проде строго False: при True наружу уходят трейсбеки
# с путями, настройками и локальными переменными.
DEBUG=False

# Домены, под которыми приложение согласно себя признавать (защита от подмены
# заголовка Host). Список через запятую, без пробелов. При DEBUG=False пустой
# список означает 400 на каждый запрос.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL -----------------------------------------------------------
# Эти же переменные читает официальный образ postgres при первом запуске,
# то есть они задают и саму базу, и то, как к ней подключается Django.
POSTGRES_USER=myuser
POSTGRES_PASSWORD=
POSTGRES_DB=StatF1_db
# Имя сервиса в docker-сети, не localhost: контейнеры находят друг друга по имени.
POSTGRES_HOST=db
# Необязательна, умолчание в settings.py — 5432.
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
# Кэш аналитики, распределённые локи, счётчики рейт-лимита (ГП-10, ГП-13).
# Пароль передаётся серверу через --requirepass в compose.yaml.
REDIS_PASSWORD=
REDIS_PORT=6379

# --- RabbitMQ -------------------------------------------------------------
# Брокер очередей для Celery. Из этих переменных собирается CELERY_BROKER_URL
# в settings.py; они же создают пользователя при первом запуске брокера.
RABBITMQ_DEFAULT_USER=rmuser
RABBITMQ_DEFAULT_PASS=
